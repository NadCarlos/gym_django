# DJANGO setup
DJANGO_SECRET_KEY=
DJANGO_ROOT_LOGGING_LEVEL=DEBUG
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
DJANGO_DB_CONN_MAX_AGE=0
DB_LOCK_WAIT_TIMEOUT=5
DB_SLOW_QUERY_MS=250
WRITE_DB_INSTRUMENTATION_ENABLED=True
DJANGO_ALLOWED_HOSTS=localhost,0.0.0.0,123.456.789
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# production setup -> for dev, turn all false except for debug
DJANGO_DEBUG=True
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False # set to false to avoid loop with Nginx redirect
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
USE_X_FORWARDED_HOST=False

# MYSQL database setup
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_ROOT_PASSWORD=
