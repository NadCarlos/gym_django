ARG TARGETARCH
# SQLite security update, pinned Debian packages compatible with glibc >= 2.38.
# Keep the stable base; do not enable the unstable repository in the runtime.
FROM scratch AS sqlite-amd64
ADD --checksum=sha256:7789bf0b2338b781de388d83d7c473f9386c9ef638af110b5c1b3d1debb36f00 https://deb.debian.org/debian/pool/main/s/sqlite3/libsqlite3-0_3.54.1-2_amd64.deb /libsqlite3-0.deb
FROM scratch AS sqlite-arm64
ADD --checksum=sha256:27416ae5fd9a8a491cacc2316cb08ebf31ac0d3d628da5576e04eeba365605a4 https://deb.debian.org/debian/pool/main/s/sqlite3/libsqlite3-0_3.54.1-2_arm64.deb /libsqlite3-0.deb
FROM sqlite-${TARGETARCH} AS patched-sqlite

# Official CPython currently bundles Expat 2.9.0; replace its extension with 2.10.0.
FROM python:3.13.18-slim-trixie@sha256:76baad6037690d6e8c4397fbcaef17bca6f19eecef822b708fe8fa3417d30bb5 AS patched-expat
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config xz-utils \
    && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:c624ba2998fc65df1163a49641ff3f9ab73138b11641d92c86bee0fb01b1bc7f https://github.com/libexpat/libexpat/releases/download/R_2_10_0/expat-2.10.0.tar.xz /tmp/expat.tar.xz
ADD --checksum=sha256:abb0102e6d4ae027509bcb82327d9dd85515b44a3ba8ad538cfc5e9847029f68 https://www.python.org/ftp/python/3.13.18/Python-3.13.18.tar.xz /tmp/python.tar.xz
COPY scripts/build-patched-pyexpat.sh /tmp/build-patched-pyexpat.sh
RUN sh /tmp/build-patched-pyexpat.sh

FROM python:3.13.18-slim-trixie@sha256:76baad6037690d6e8c4397fbcaef17bca6f19eecef822b708fe8fa3417d30bb5 AS certbot-python

FROM nginx:1.31.8@sha256:6e67f8eaac94fc456588d4ff6c470d984841f5b5dc4279863d5cbe6ec5a60def AS base

ENV PATH="/usr/local/bin:$PATH" LANG=C.UTF-8
COPY --from=certbot-python /usr/local /usr/local
COPY --from=patched-expat /out/ /usr/local/lib/python3.13/lib-dynload/
RUN python3 -c 'import pyexpat; assert pyexpat.version_info == (2, 10, 0), pyexpat.EXPAT_VERSION'
COPY config/dpkg-runtime-excludes /etc/dpkg/dpkg.cfg.d/cermed-runtime-excludes
RUN --mount=type=bind,from=patched-sqlite,source=/libsqlite3-0.deb,target=/tmp/libsqlite3-0.deb \
    apt-get update \
    && apt-get upgrade -y \
    # Native runtime libraries of the official Python image, on the same Debian.
    && apt-get install -y --no-install-recommends cron ca-certificates netbase tzdata \
        libbz2-1.0 libdb5.3t64 libffi8 libgdbm6t64 liblzma5 libncursesw6 \
        libreadline8t64 libsqlite3-0 libssl3t64 libtinfo6 libuuid1 libzstd1 zlib1g \
    # CERMED uses the core proxy/static/TLS modules and Certbot webroot.
    # These optional modules are not loaded by cermed.conf or nginx.conf.
    && apt-get purge -y --auto-remove \
        curl nginx-module-acme nginx-module-geoip nginx-module-image-filter \
        nginx-module-njs nginx-module-xslt \
    && dpkg -i /tmp/libsqlite3-0.deb \
    && python3 -c 'import sqlite3; assert sqlite3.sqlite_version_info == (3, 54, 1), sqlite3.sqlite_version' \
    && rm -f /usr/bin/nsenter /usr/bin/infocmp \
    && ldconfig \
    && python3 -c 'import sys; assert sys.version_info[:3] == (3, 13, 18)' \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir pip==26.2.2

# Build a locked Certbot environment without Debian's older Python dependencies.
FROM base AS certbot-dependencies
RUN python3 -m venv /opt/certbot
COPY requirements-certbot.txt /tmp/requirements-certbot.txt
RUN /opt/certbot/bin/pip install --no-cache-dir pip==26.2.2 \
    && /opt/certbot/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements-certbot.txt \
    && /opt/certbot/bin/pip check

FROM base AS runtime
COPY --from=certbot-dependencies /opt/certbot /opt/certbot
# Debian cron has a minimal PATH; keep the command available in /usr/bin.
RUN ln -s /opt/certbot/bin/certbot /usr/bin/certbot \
    && certbot --version
